# Fixed. Where the API is — not whose shop we are asking about. The shop comes
# from the address the visitor is on, so this never changes per shop.
PUBLIC_API_URL=http://localhost:8088

# What the API knows shops by. A storefront lives at <slug>.<this>, in dev and
# in production alike: rahim.dukkan.localhost:5173 here, rahim.dukkan.store there.
PUBLIC_SHOP_DOMAIN=dukkan.localhost

PUBLIC_SITE_URL=http://localhost:5173
